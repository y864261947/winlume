/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# deployment artifacts
*.tar.gz
/_deploy_stage/
/_deploy_clean/
/_tmp_newmax_extract/
/_tmp_newmax_peek/

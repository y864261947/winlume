{
  "defaults": {
    "quota_per_unit": "500000",
    "pre_consumed_tokens": 500
  },
  "cases": [
    {
      "name": "openai_cached_ratio",
      "rule": {
        "mode": "ratio",
        "model_ratio": "0.5",
        "completion_ratio": "4",
        "cache_read_ratio": "0.1"
      },
      "group_ratio": "1.2",
      "estimate": { "prompt_tokens": 1000, "max_output_tokens": 100 },
      "usage": { "text_input_tokens": 600, "cache_read_tokens": 400, "text_output_tokens": 100 },
      "expected": {
        "reservation": 660,
        "quota": 624,
        "delta": -36,
        "breakdown": { "text_input": 360, "cache_read": 24, "text_output": 240 }
      }
    },
    {
      "name": "fixed_half",
      "rule": { "mode": "fixed", "fixed_price_usd": "0.000001" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 1 },
      "usage": { "text_input_tokens": 1 },
      "expected": {
        "reservation": 0,
        "quota": 1,
        "delta": 1,
        "breakdown": { "fixed": 1 }
      }
    },
    {
      "name": "ratio_minimum",
      "rule": { "mode": "ratio", "model_ratio": "0.4" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 1, "max_output_tokens": 1 },
      "usage": { "text_input_tokens": 1 },
      "expected": {
        "reservation": 200,
        "quota": 1,
        "delta": -199,
        "breakdown": { "text_input": 0, "minimum": 1 }
      }
    },
    {
      "name": "claude_split",
      "rule": {
        "mode": "ratio",
        "model_ratio": "1",
        "completion_ratio": "2",
        "cache_read_ratio": "0.1",
        "cache_write_ratio": "1.25",
        "cache_write_one_hour_ratio": "2"
      },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 1000, "max_output_tokens": 200 },
      "usage": {
        "text_input_tokens": 1000,
        "cache_read_tokens": 100,
        "cache_write_tokens": 50,
        "cache_write_5m_tokens": 10,
        "cache_write_1h_tokens": 20,
        "text_output_tokens": 200
      },
      "expected": {
        "reservation": 1200,
        "quota": 1488,
        "delta": 288,
        "breakdown": {
          "text_input": 1000,
          "cache_read": 10,
          "cache_write": 25,
          "cache_write_5m": 13,
          "cache_write_1h": 40,
          "text_output": 400
        }
      }
    },
    {
      "name": "media_image_audio",
      "rule": {
        "mode": "ratio",
        "model_ratio": "0.5",
        "completion_ratio": "2",
        "image_ratio": "3",
        "audio_input_ratio": "4",
        "audio_completion_ratio": "5"
      },
      "group_ratio": "1.1",
      "estimate": { "prompt_tokens": 100, "max_output_tokens": 20 },
      "usage": {
        "text_input_tokens": 100,
        "text_output_tokens": 10,
        "image_input_tokens": 2,
        "image_output_tokens": 3,
        "audio_input_tokens": 4,
        "audio_output_tokens": 5
      },
      "expected": {
        "reservation": 286,
        "quota": 97,
        "delta": -189,
        "breakdown": {
          "text_input": 55,
          "text_output": 11,
          "image_input": 3,
          "image_output": 5,
          "audio_input": 9,
          "audio_output": 14
        }
      }
    },
    {
      "name": "audio_endpoint_ratios",
      "rule": {
        "mode": "ratio",
        "model_ratio": "0.5",
        "audio_input_ratio": "3",
        "audio_completion_ratio": "4"
      },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 1 },
      "usage": { "text_input_tokens": 1, "audio_input_tokens": 10, "audio_output_tokens": 20 },
      "expected": {
        "reservation": 250,
        "quota": 56,
        "delta": -194,
        "breakdown": { "text_input": 1, "audio_input": 15, "audio_output": 40 }
      }
    },
    {
      "name": "tiered_tools",
      "rule": {
        "mode": "tiered_expr",
        "tiered_expression": "v1:p * 2 + c * 4",
        "tool_prices": { "web_search": "0.01" }
      },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 100, "max_output_tokens": 10 },
      "usage": { "text_input_tokens": 100, "text_output_tokens": 10, "calls": { "web_search": 2 } },
      "expected": {
        "reservation": 120,
        "quota": 130,
        "delta": 10,
        "breakdown": { "tiered": 120, "tool:web_search": 10 }
      }
    },
    {
      "name": "tier_crossing",
      "rule": {
        "mode": "tiered_expr",
        "tiered_expression": "v1:p <= 100 ? tier(\"low\", p * 2) : tier(\"high\", p * 4)"
      },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 100 },
      "usage": { "text_input_tokens": 101 },
      "expected": {
        "reservation": 100,
        "quota": 202,
        "delta": 102,
        "breakdown": { "tiered": 202 }
      }
    },
    {
      "name": "missing_usage_estimate",
      "rule": { "mode": "ratio", "model_ratio": "0.5" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 40 },
      "usage": { "text_input_tokens": 40 },
      "expected": {
        "reservation": 250,
        "quota": 20,
        "delta": -230,
        "breakdown": { "text_input": 20 }
      }
    },
    {
      "name": "partial_stream_local_output",
      "rule": { "mode": "ratio", "model_ratio": "0.5", "completion_ratio": "2" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 50, "max_output_tokens": 100 },
      "usage": { "text_input_tokens": 50, "text_output_tokens": 12, "terminal_event": "client_disconnected" },
      "expected": {
        "reservation": 300,
        "quota": 37,
        "delta": -263,
        "breakdown": { "text_input": 25, "text_output": 12 }
      }
    },
    {
      "name": "zero_usage_fixed",
      "rule": { "mode": "fixed", "fixed_price_usd": "0.002" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 10 },
      "usage": {},
      "expected": {
        "reservation": 1000,
        "quota": 0,
        "delta": -1000,
        "breakdown": {}
      }
    },
    {
      "name": "channel_cost_profit",
      "rule": {
        "mode": "ratio",
        "model_ratio": "1",
        "completion_ratio": "2",
        "channel_cost": { "input_price_usd": "2", "output_price_usd": "4", "fixed_price_usd": "0" }
      },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 10, "max_output_tokens": 5 },
      "usage": { "text_input_tokens": 10, "text_output_tokens": 5 },
      "expected": {
        "reservation": 505,
        "quota": 20,
        "delta": -485,
        "cost_quota": 20,
        "profit_quota": 0,
        "breakdown": { "text_input": 10, "text_output": 10 }
      }
    },
    {
      "name": "no_channel_cost_nil",
      "rule": { "mode": "ratio", "model_ratio": "1" },
      "group_ratio": "1",
      "estimate": { "prompt_tokens": 10 },
      "usage": { "text_input_tokens": 10 },
      "expected": {
        "reservation": 500,
        "quota": 10,
        "delta": -490,
        "cost_quota": null,
        "profit_quota": null,
        "breakdown": { "text_input": 10 }
      }
    }
  ]
}

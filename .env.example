# NewAPI-compatible gateway origin (no trailing slash required)
NEW_API_URL=https://v2api.top

# Auth.js session origin and server-only secret. Generate a distinct random value per environment.
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# v2api OAuth client credentials (server-only)
AUTH_V2API_ID=winlume
AUTH_V2API_SECRET=

# Reserved for the Google account-linking phase.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Server-side Bearer token for chat completions (never expose to the browser)
WINLUME_GATEWAY_TOKEN=

# Server-side Bearer token for image generation/edit (separate token/channel from chat)
WINLUME_IMAGE_GATEWAY_TOKEN=

# optional override for the image model id (default: gpt-image-2)
# WINLUME_IMAGE_MODEL=gpt-image-2

# optional override for chat path
# WINLUME_CHAT_PATH=/v1/chat/completions

# Agent execution modes accepted by POST /api/chat:
# - studio: current compatibility runtime (default)
# - ai-sdk: Vercel AI SDK transport + WinLume tool/runtime policy
# - codex: Codex coding specialist (server-side only)
# WINLUME_AGENT_EXECUTION_MODE=studio
# Enable Codex explicitly for authenticated users on a trusted worker host.
# WINLUME_CODEX_ENABLED=false
# Required while Codex uses a single global workspace. Only this authenticated
# user can invoke it; use per-project isolated workers before allowing a team.
# WINLUME_CODEX_TRUSTED_USER_ID=
# Optional; omit to use the Codex SDK default model.
# WINLUME_CODEX_MODEL=
# Required absolute path. Codex is confined here with workspace-write,
# no escalation, command network access, or web search.
# WINLUME_CODEX_WORKSPACE_DIR=/absolute/path/to/trusted/workspace
# Required absolute path for an isolated Codex home. Do not reuse a developer's
# CODEX_HOME: WinLume clears MCP configuration for this worker.
# WINLUME_CODEX_HOME=/absolute/path/to/winlume-codex-home
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# optional local data root for web file store (default: ./data)
# WINLUME_DATA_DIR=

# Durable run policy and local worker adapter. The default policy permits only
# studio and ai-sdk; Codex also requires WINLUME_CODEX_ENABLED=true and
# WINLUME_CODEX_TRUSTED_USER_ID.
# WINLUME_RUN_ALLOWED_EXECUTION_MODES=studio,ai-sdk
# WINLUME_RUN_ALLOWED_MODELS=
# WINLUME_RUN_DENIED_TOOLS=
# WINLUME_RUN_APPROVAL_REQUIRED_TOOLS=
# WINLUME_RUN_TOOL_APPROVAL=on-request
# WINLUME_RUN_MAX_DURATION_MS=600000
# WINLUME_RUN_MAX_INPUT_CHARS=100000
# WINLUME_RUN_MAX_TOOL_CALLS=64
# WINLUME_RUN_MAX_ATTEMPTS=3
# Reserved until the provider transport reports metered usage per run.
# WINLUME_RUN_MAX_OUTPUT_TOKENS=
# WINLUME_RUN_MAX_COST_USD=
# WINLUME_RUN_LEASE_MS=30000

# Legacy NewAPI-compatible gateway origin (no trailing slash required). Leave
# unset in native mode. Set it only for an explicit compatibility window or
# the one-time migration; the standalone Reizo gateway never reads it.
# NEW_API_URL=https://v2api.top

# Auth.js session origin and server-only secret. Generate a distinct random value per environment.
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=

# Reizo platform PostgreSQL (credentials, workspaces, keys, wallet and usage)
DATABASE_URL=

# Defaults to the Reizo database identity. Set to legacy only during an
# explicit compatibility window; it is the only mode that contacts new-api.
REIZO_AUTH_MODE=reizo
REIZO_BCRYPT_COST=12

# Legacy v2api OAuth client credentials (server-only; legacy auth mode only)
AUTH_V2API_ID=reizo
AUTH_V2API_SECRET=

# Google OAuth (Auth.js). When both are set in reizo mode, LoginModal shows
# "使用 Google 继续". Redirect URI must be:
#   {NEXTAUTH_URL}/api/auth/callback/google
# e.g. https://winlume.v2api.top/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Single service-account Bearer token for all Reizo-to-gateway traffic
# (chat and image). Issued once via:
#   go run ./services/gateway/cmd/create-service-account -username svc-reizo-app -display-name "Reizo App"
# Never expose it to the browser.
REIZO_SERVICE_KEY=

# Shared secret between this Next.js server and the gateway's
# /internal/admin/* API (services/gateway). Must match
# REIZO_GATEWAY_ADMIN_TOKEN on the gateway process. Never expose it to
# the browser.
REIZO_GATEWAY_ADMIN_TOKEN=

# Native Studio-to-gateway origin. The native default is http://127.0.0.1:4010.
# Set this when the Next process and gateway run on different hosts.
# REIZO_GATEWAY_URL=http://127.0.0.1:4010

# Standalone Reizo protocol gateway. This service does not use NEW_API_URL.
# REIZO_GATEWAY_HOST=127.0.0.1
# REIZO_GATEWAY_PORT=4010
# Required whenever the gateway opens its database-backed store, i.e. in
# REIZO_GATEWAY_BILLING_MODE=shadow (the default) or =authoritative - the
# process fails to start without it. AES-256 key encrypting the channels
# table's api_key column at rest (services/gateway/internal/storage/channels.go).
# Must decode to exactly 32 bytes: either 64 hex characters, or base64
# (standard or URL-safe, padded or not). Generate one with:
#   openssl rand -hex 32
# Losing this key makes every stored channel api_key permanently unreadable;
# back it up like any other production secret. Only REIZO_GATEWAY_BILLING_MODE=off
# (no billing database at all) can run without it.
# REIZO_CHANNEL_ENCRYPTION_KEY=
# Trust client IP forwarding only from this reverse-proxy allowlist. The
# default is local nginx (127.0.0.1 and ::1); set CIDRs explicitly when the
# proxy runs on another host.
# REIZO_GATEWAY_TRUSTED_PROXY_IPS=127.0.0.1,::1
# REIZO_GATEWAY_BODY_LIMIT_BYTES=52428800
# REIZO_GATEWAY_OPENAI_UPSTREAM_URL=https://provider.example
# REIZO_GATEWAY_OPENAI_UPSTREAM_API_KEY=
# Prefer the platform database when DATABASE_URL is configured. Set false
# only when the gateway is deliberately using static hashes below.
# REIZO_GATEWAY_USE_PLATFORM_DATABASE=true
# Comma-separated SHA-256 digests of issued API keys (fallback/test mode).
# REIZO_GATEWAY_API_KEY_HASHES=
# Keep false in production. Enabling this bypasses API-key verification.
# REIZO_GATEWAY_ALLOW_UNVERIFIED_KEYS=false
# Server-to-server Studio token. Never expose it to the browser.
# REIZO_GATEWAY_INTERNAL_TOKEN=
# Studio sends x-reizo-internal-token plus x-reizo-internal-user-id.
# The x-reizo-internal-identity and x-reizo-internal-user aliases are
# accepted only with the same token. New-Api-User is never trusted from clients.
# REIZO_GATEWAY_CORS_ORIGINS=https://app.winlume.example
# Fixed wallet reservation before forwarding and settlement after a successful
# upstream response, in microcredits. A provider response may override the
# settlement with x-reizo-cost-microcredits. Zero records usage without a
# debit/hold; choose a positive value to enforce prepaid credits.
# REIZO_GATEWAY_RESERVATION_MICROCREDITS=0
# REIZO_GATEWAY_REQUEST_COST_MICROCREDITS=0
# Billing safety gate: off performs no billing, shadow writes usage/ledger
# rows without owning quota enforcement (default, safe alongside legacy
# billing), authoritative makes the Go gateway the sole quota/ledger owner.
# REIZO_GATEWAY_BILLING_MODE=shadow
# Required (must be "go") only when REIZO_GATEWAY_BILLING_MODE=authoritative.
# REIZO_GATEWAY_BILLING_OWNER=
# Required for authoritative billing: "provider" for a directly-billed
# upstream, or "non_charging_new_api" for a new-api upstream that never bills.
# REIZO_GATEWAY_UPSTREAM_OWNERSHIP=
# Required for authoritative billing: an absolute, gateway-owned, writable
# directory for crash-recovery journals. Must not be shared with any other
# process; the systemd unit should own this path (see services/gateway/README.md).
# REIZO_GATEWAY_RECOVERY_DIR=/var/lib/reizo-gateway/recovery

# One-time new-api migration. Keep all source/export/artifact paths outside
# the repository and restrict them to the migration operator. The command is
# dry-run by default; writes additionally require an explicit --apply flag.
# NEW_API_MIGRATION_SOURCE_FILE=/secure/new-api-export.json
# NEW_API_MIGRATION_SOURCE_DATABASE_URL=
# NEW_API_MIGRATION_SOURCE_LOG_DATABASE_URL=
# NEW_API_MIGRATION_REPORT_FILE=/secure/new-api-reconciliation.json
# NEW_API_MIGRATION_CHANNEL_ARTIFACT_FILE=/secure/new-api-channels.enc.json
# NEW_API_MIGRATION_SNAPSHOT_OUT=/secure/new-api-raw-snapshot.json
# REIZO_MIGRATION_CHANNEL_ENCRYPTION_KEY=
# NEW_API_MIGRATION_PRESERVE_CIPHERTEXT=1

# optional override for the image model id (default: gpt-image-2)
# REIZO_IMAGE_MODEL=gpt-image-2

# Alibaba Cloud VIAPI image tools. Use a dedicated least-privilege RAM/STS
# identity, never a root account or a local Aliyun CLI/OAuth profile. The OSS
# bucket remains private and must be in Shanghai for the VIAPI signed-URL flow.
ALIYUN_VIAPI_ACCESS_KEY_ID=
ALIYUN_VIAPI_ACCESS_KEY_SECRET=
ALIYUN_VIAPI_OSS_BUCKET=
ALIYUN_VIAPI_OSS_REGION=oss-cn-shanghai

# Cloudflare R2 durable artifact content. These are server-only S3 credentials;
# do not use NEXT_PUBLIC_ variables and never commit real values.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# optional override for chat path
# REIZO_CHAT_PATH=/v1/chat/completions

# Agent execution modes accepted by POST /api/chat:
# - studio: current compatibility runtime (default)
# - ai-sdk: Vercel AI SDK transport + Reizo tool/runtime policy
# - codex: Codex coding specialist (server-side only)
# REIZO_AGENT_EXECUTION_MODE=studio
# Enable Codex explicitly for authenticated users on a trusted worker host.
# REIZO_CODEX_ENABLED=false
# Required while Codex uses a single global workspace. Only this authenticated
# user can invoke it; use per-project isolated workers before allowing a team.
# REIZO_CODEX_TRUSTED_USER_ID=
# Optional; omit to use the Codex SDK default model.
# REIZO_CODEX_MODEL=
# Required absolute path. Codex is confined here with workspace-write,
# no escalation, command network access, or web search.
# REIZO_CODEX_WORKSPACE_DIR=/absolute/path/to/trusted/workspace
# Required absolute path for an isolated Codex home. Do not reuse a developer's
# CODEX_HOME: Reizo clears MCP configuration for this worker.
# REIZO_CODEX_HOME=/absolute/path/to/reizo-codex-home
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# optional local data root for web file store (default: ./data)
# REIZO_DATA_DIR=

# Reference-video analysis. The Next.js service only dispatches work; run the
# isolated media worker separately with the same private token and keep both
# listeners on a trusted network / loopback interface.
# REIZO_MEDIA_WORKER_URL=http://127.0.0.1:4020
# REIZO_MEDIA_WORKER_TOKEN=
# REIZO_MEDIA_APP_URL=http://127.0.0.1:3000
# REIZO_MEDIA_WORKER_HOST=127.0.0.1
# REIZO_MEDIA_WORKER_PORT=4020
# REIZO_MEDIA_MAX_DURATION_SECONDS=600
# REIZO_FFPROBE_PATH=ffprobe
# REIZO_FFMPEG_PATH=ffmpeg

# Durable run policy and local worker adapter. The default policy permits only
# studio and ai-sdk; Codex also requires REIZO_CODEX_ENABLED=true and
# REIZO_CODEX_TRUSTED_USER_ID.
# REIZO_RUN_ALLOWED_EXECUTION_MODES=studio,ai-sdk
# REIZO_RUN_ALLOWED_MODELS=
# REIZO_RUN_DENIED_TOOLS=
# REIZO_RUN_APPROVAL_REQUIRED_TOOLS=
# REIZO_RUN_TOOL_APPROVAL=on-request
# REIZO_RUN_MAX_DURATION_MS=600000
# REIZO_RUN_MAX_INPUT_CHARS=100000
# REIZO_RUN_MAX_TOOL_CALLS=64
# REIZO_RUN_MAX_ATTEMPTS=3
# Reserved until the provider transport reports metered usage per run.
# REIZO_RUN_MAX_OUTPUT_TOKENS=
# REIZO_RUN_MAX_COST_USD=
# REIZO_RUN_LEASE_MS=30000
